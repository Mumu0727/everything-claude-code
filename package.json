  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jt-team/jtcc.git"
  },
  "homepage": "https://github.com/jt-team/jtcc#readme",
  "bugs": {
    "url": "https://github.com/jt-team/jtcc/issues"
  },
  "files": [
