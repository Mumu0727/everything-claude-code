  "bin": {
    "jtcc": "scripts/jtcc.js"
  },
  "scripts": {
    "postinstall": "node -e \"console.log('\\nJ&T Claude Code (JTCC) installed!\\n  Run: jtcc install\\n  Commands: /jtcc:plan, /jtcc:tdd, /jtcc:code-review, /jtcc:e2e, /jtcc:refactor, /jtcc:multi\\n  List: jtcc list | Status: jtcc status | Update: jtcc update\\n  OpenSpec: jtcc spec list, jtcc spec show <id>');\"",
    "test": "node tests/run-all.js"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "ajv": "^8.18.0",
    "c8": "^10.1.2",
