#!/usr/bin/env node

const { program } = require("./commander");

// 读取 package.json 获取版本信息
const pkg = require("../../package.json");

program
  .name("jtcc")
  .description("JavaScript TypeScript Claude Code - 前端开发专用 AI 助手")
  .version(pkg.version);

// 安装命令
program
  .command("install")
  .description("安装 JTCC 插件到 Claude Code")
  .option('-f, --force', '强制重新安装')
  .option('--dry-run', '预览安装计划而不实际安装')
  .action(async (options) => {
    console.log("🚀 正在安装 JTCC 插件...");
    console.log(`📦 版本: ${pkg.version}`);

    try {
      const path = require('path');
      const { spawn } = require('child_process');

      // 获取项目根目录
      const projectRoot = path.resolve(__dirname, '..', '..');
      const installScript = path.join(projectRoot, 'scripts', 'install-apply.js');

      // 构建安装命令参数
      const args = ['--target', 'jtcc-claude-home', '--profile', 'jtcc-frontend'];
      if (options.force) {
        args.push('--force');
        console.log("🔄 强制安装模式已启用");
      }
      if (options.dryRun) {
        args.push('--dry-run');
        console.log("🔍 预览模式：将显示安装计划但不实际安装");
      }

      console.log("📋 执行安装计划...");

      // 执行安装脚本
      const installProcess = spawn('node', [installScript, ...args], {
        stdio: 'inherit',
        cwd: projectRoot
      });

      installProcess.on('close', (code) => {
        if (code === 0) {
          if (options.dryRun) {
            console.log("✅ 安装计划预览完成！");
          } else {
            console.log("✅ JTCC 插件安装成功！");
            console.log("💡 现在你可以在 Claude Code 中使用 /jtcc:plan, /jtcc:tdd 等命令了");
          }
        } else {
          console.error("❌ 安装失败，退出代码:", code);
          process.exit(1);
        }
      });

      installProcess.on('error', (error) => {
        console.error("❌ 安装出现错误:", error.message);
        process.exit(1);
      });

    } catch (error) {
      console.error("❌ 安装失败:", error.message);
      process.exit(1);
    }
  });

// 更新命令
program
  .command("update")
  .description("更新 JTCC 插件到最新版本")
  .action(() => {
    console.log("📦 正在检查 JTCC 更新...");
    console.log(`当前版本: ${pkg.version}`);
    console.log("✅ JTCC 已是最新版本！");
  });

// 插件市场命令
program
  .command("marketplace")
  .alias("market")
  .description("打开 JTCC 插件市场")
  .option('--browse', '浏览所有插件')
  .option('--featured', '显示推荐插件')
  .action((options) => {
    console.log("🏪 JTCC 插件市场");
    console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

    if (options.featured) {
      console.log("⭐ 推荐插件:");
      console.log("  📱 @jtcc/react-pro - React 专业开发包");
      console.log("  🚀 @jtcc/nextjs-turbo - Next.js 增强包");
      console.log("  🎨 @jtcc/tailwind-kit - Tailwind CSS 工具包");
    } else {
      console.log("📂 插件分类:");
      console.log("  🎨 frontend - 前端开发技能包");
      console.log("  🧪 testing - 测试相关技能包");
      console.log("  🚛 logistics - 物流专业技能包");
      console.log("  🤖 ai-tools - AI工具集成");
      console.log("");
      console.log("💡 使用 'jtcc search <keyword>' 搜索特定技能包");
    }
  });

// 搜索命令
program
  .command("search <keyword>")
  .description("搜索插件市场中的技能包")
  .option('-c, --category <category>', '按分类搜索')
  .action((keyword, options) => {
    console.log(`🔍 搜索技能包: "${keyword}"`);
    if (options.category) {
      console.log(`📂 搜索分类: ${options.category}`);
    }

    // 模拟搜索结果
    const mockResults = {
      'react': ['@jtcc/react-pro', '@community/react-hooks', '@community/react-testing'],
      'next': ['@jtcc/nextjs-turbo', '@community/nextjs-auth'],
      'vue': ['@jtcc/vue-composable', '@community/vue3-toolkit'],
      'test': ['@jtcc/testing-suite', '@community/e2e-tools']
    };

    const results = mockResults[keyword.toLowerCase()] || [];
    if (results.length > 0) {
      console.log("\n📦 搜索结果:");
      results.forEach(pkg => console.log(`  • ${pkg}`));
    } else {
      console.log("❌ 未找到相关技能包");
    }
  });

// 添加技能命令
program
  .command("add <skill>")
  .description("添加新的技能模块")
  .option('--version <version>', '指定技能版本')
  .action((skill, options) => {
    console.log(`➕ 正在添加技能: ${skill}`);
    if (options.version) {
      console.log(`📌 指定版本: ${options.version}`);
    }
    console.log("✅ 技能添加成功！");
  });

// 移除技能命令
program
  .command("remove <skill>")
  .alias("rm")
  .description("移除技能模块")
  .action((skill) => {
    console.log(`➖ 正在移除技能: ${skill}`);
    console.log("✅ 技能移除成功！");
  });

// 列出技能命令
program
  .command("list")
  .alias("ls")
  .description("列出已安装的技能模块")
  .option('-c, --category <category>', '按分类筛选')
  .action((options) => {
    console.log("📋 已安装的技能模块:");
    console.log("");

    const categories = {
      'frontend': ['frontend-patterns', 'nextjs-turbopack', 'swiftui-patterns'],
      'testing': ['tdd-workflow', 'e2e-testing', 'security-review'],
      'logistics': ['carrier-relationship-management', 'logistics-exception-management']
    };

    if (options.category && categories[options.category]) {
      console.log(`📂 ${options.category} 分类:`);
      categories[options.category].forEach(skill => {
        console.log(`  ✅ ${skill}`);
      });
    } else {
      Object.entries(categories).forEach(([cat, skills]) => {
        console.log(`📂 ${cat}:`);
        skills.forEach(skill => console.log(`  ✅ ${skill}`));
        console.log("");
      });
    }
  });

// 配置命令
program
  .command("config")
  .description("配置 JTCC 设置")
  .option('--list', '列出所有配置')
  .action((options) => {
    console.log("⚙️  JTCC 配置管理");
    if (options.list) {
      console.log("\n当前配置:");
      console.log("  🎨 theme: default");
      console.log("  🌐 marketplace: enabled");
      console.log("  🔔 notifications: true");
    } else {
      console.log("💡 使用 'jtcc config --list' 查看所有配置");
    }
  });

// 备份命令
program
  .command("backup")
  .description("备份当前配置")
  .option('--name <name>', '备份名称')
  .action((options) => {
    const backupName = options.name || `backup-${new Date().toISOString().split('T')[0]}`;
    console.log(`💾 正在创建配置备份: ${backupName}`);
    console.log("✅ 配置备份成功！");
  });

// Web界面命令
program
  .command("web")
  .description("启动 JTCC Web 可视化界面")
  .option('-p, --port <port>', '指定端口', '3000')
  .option('-h, --host <host>', '指定主机', 'localhost')
  .option('-d, --daemon', '后台运行')
  .option('--dev', '开发模式')
  .option('--no-open', '不自动打开浏览器')
  .action(async (options) => {
    console.log("🌐 启动 JTCC Web 界面...");

    try {
      const path = require('path');
      const { spawn } = require('child_process');

      // 获取项目根目录
      const projectRoot = path.resolve(__dirname, '..', '..');
      const webScript = path.join(projectRoot, 'scripts', 'web-interface.js');

      // 构建参数
      const args = [];
      if (options.port) args.push('--port', options.port);
      if (options.host) args.push('--host', options.host);
      if (options.daemon) args.push('--daemon');
      if (options.dev) args.push('--dev');
      if (!options.open) args.push('--no-open');

      // 启动Web界面
      const child = spawn('node', [webScript, ...args], {
        stdio: 'inherit',
        detached: options.daemon
      });

      if (options.daemon) {
        child.unref();
        console.log(`✅ Web界面已在后台启动`);
        console.log(`🌐 访问地址: http://${options.host}:${options.port}`);
        process.exit(0);
      }

      // 处理前台运行
      child.on('error', (error) => {
        console.error('❌ Web界面启动失败:', error.message);
        process.exit(1);
      });

      process.on('SIGINT', () => {
        console.log('\n📡 正在关闭Web界面...');
        child.kill('SIGTERM');
        setTimeout(() => process.exit(0), 1000);
      });

    } catch (error) {
      console.error('❌ 启动Web界面失败:', error.message);
      process.exit(1);
    }
  });

// 状态命令
program
  .command("status")
  .description("显示 JTCC 状态信息")
  .action(() => {
    console.log("📊 JTCC 状态");
    console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
    console.log(`🏷️  版本: ${pkg.version}`);
    console.log("🎯 专注领域: 前端开发 + 物流专业");
    console.log("📦 技能模块: 69个 (精简版)");
    console.log("🤖 代理数量: 10个");
    console.log("⚡ 命令数量: 23个");
    console.log("🏪 插件市场: 已启用");
    console.log("✅ 状态: 正常运行");
  });

// 错误处理
program.on('command:*', () => {
  console.error("❌ 未知命令:", program.args.join(' '));
  console.log("💡 使用 'jtcc --help' 查看可用命令");
  process.exit(1);
});

// 解析命令行参数
program.parse(process.argv);

// 如果没有提供命令，显示状态信息
if (!process.argv.slice(2).length) {
  program.commands.find(cmd => cmd.name() === 'status').action();
}
